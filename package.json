{
  "name": "swarlekh",
  "version": "1.0.0",
  "description": "Sargam notation from Hindustani vocal recordings — on-device, with an optional local analysis server",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.js",
    "benchmark:app": "node evaluation/app-benchmark.js",
    "benchmark:synthetic": "node evaluation/synthetic-hindustani.js",
    "benchmark:saraga": "node evaluation/evaluate-saraga.js",
    "benchmark:download:vocadito": "bash evaluation/download-vocadito.sh",
    "benchmark:vocadito": "node evaluation/evaluate-vocadito.js",
    "benchmark:tune:vocadito": "node evaluation/evaluate-vocadito.js --tune",
    "benchmark:game": "node evaluation/evaluate-game.js",
    "benchmark:pitch": "node evaluation/evaluate-pitch-model.js",
    "benchmark:vocalset": "node evaluation/evaluate-vocalset.js",
    "serve": "python3 -m http.server 4173"
  },
  "license": "MIT"
}
